+
+// injectKey schreibt Druecken+Loslassen einer Taste in ein evdev-Geraet (32-bit input_event).
+func injectKey(dev string, code uint16) {
+	f, err := os.OpenFile(dev, os.O_WRONLY, 0)
+	if err != nil {
+		log.Warnf("injectKey %s: %v", dev, err)
+		return
+	}
+	defer f.Close()
+	ev := func(typ, c uint16, val int32) []byte {
+		b := make([]byte, 16)
+		binary.LittleEndian.PutUint16(b[8:], typ)
+		binary.LittleEndian.PutUint16(b[10:], c)
+		binary.LittleEndian.PutUint32(b[12:], uint32(val))
+		return b
+	}
+	var buf []byte
+	buf = append(buf, ev(1, code, 1)...)
+	buf = append(buf, ev(0, 0, 0)...)
+	buf = append(buf, ev(1, code, 0)...)
+	buf = append(buf, ev(0, 0, 0)...)
+	f.Write(buf)
+	log.Infof("Taste %d an %s", code, dev)
+}
+
+var autoPlayMu sync.Mutex
+
+// playerSpielt: pcmshim.so beruehrt /tmp/pcm_alive jede Sekunde, solange der Player Ton schreibt.
+func playerSpielt() bool {
+	st, err := os.Stat("/tmp/pcm_alive")
+	return err == nil && time.Since(st.ModTime()) < 3*time.Second
+}
+
+// autoPlay: Radio hat sich verbunden -> wenn der Player nicht spielt, einmal Play/Pause druecken
+// (Player macht dort weiter, wo er war).
+func autoPlay() {
+	if !autoPlayMu.TryLock() {
+		return
+	}
+	defer autoPlayMu.Unlock()
+	time.Sleep(4 * time.Second)
+	if playerSpielt() {
+		log.Info("AutoPlay: Player spielt schon")
+		return
+	}
+	log.Info("AutoPlay: Player spielt nicht -> Play")
+	injectKey("/dev/input/event2", 164)
+	time.Sleep(4 * time.Second)
+	log.Infof("AutoPlay: spielt jetzt=%v", playerSpielt())
+}
diff --git a/cmd/ipod/nowplaying.go b/cmd/ipod/nowplaying.go
new file mode 100644
index 0000000..801216b
--- /dev/null
+++ b/cmd/ipod/nowplaying.go
@@ -0,0 +1,367 @@
+package main
+
+// Aktueller Titel des HiBy-Players: pcmshim.so schreibt den Pfad jeder vom Player
+// geoeffneten Audiodatei nach /tmp/now_playing. Wir lesen Tags + Dauer aus der Datei
+// und melden dem Radio Titelwechsel per PlayStatusChangeNotification.
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/oandrew/ipod"
+	"github.com/oandrew/ipod/lingo-extremote"
+)
+
+
+type trackMeta struct {
+	path, title, artist, album string
+	durMs                      uint32
+	start                      time.Time
+	index                      int32
+}
+
+var (
+	npMu  sync.Mutex
+	np    *trackMeta
+	npIdx int32
+)
+
+func currentTrack() *trackMeta {
+	npMu.Lock()
+	defer npMu.Unlock()
+	return np
+}
+
+func watchNowPlaying() {
+	last := ""
+	for range time.Tick(500 * time.Millisecond) {
+		p := playerAudioFile()
+		if p == "" || p == last {
+			continue
+		}
+		last = p
+		m := readMeta(p)
+		npMu.Lock()
+		npIdx++
+		m.index = npIdx
+		m.start = time.Now()
+		np = m
+		npMu.Unlock()
+		log.Infof("Titel: %q – %q (%q) %d ms", m.artist, m.title, m.album, m.durMs)
+		if f := asyncSend; f != nil {
+			buf := ipod.CmdBuffer{}
+			ipod.Send(&buf, &extremote.PlayStatusChangeNotification{Status: 0x01, Value: uint32(m.index)})
+			for _, c := range buf.Commands {
+				f(c)
+			}
+		}
+	}
+}
+
+var reTrackNr = regexp.MustCompile(`^\d+\s*[-._]\s*`)
+var reYear = regexp.MustCompile(`^\d{4}\s*-\s*`)
+
+func readMeta(p string) *trackMeta {
+	m := &trackMeta{path: p}
+	// Fallback aus dem Pfad: Interpret/JJJJ - Album/NN - Titel.ext
+	base := strings.TrimSuffix(filepath.Base(p), filepath.Ext(p))
+	m.title = reTrackNr.ReplaceAllString(base, "")
+	dir := filepath.Dir(p)
+	m.album = reYear.ReplaceAllString(filepath.Base(dir), "")
+	m.artist = filepath.Base(filepath.Dir(dir))
+
+	f, err := os.Open(p)
+	if err != nil {
+		return m
+	}
+	defer f.Close()
+	head := make([]byte, 256*1024)
+	n, _ := io.ReadFull(f, head)
+	head = head[:n]
+	var tags map[string]string
+	switch {
+	case bytes.HasPrefix(head, []byte("OggS")):
+		tags = oggTags(head)
+		m.durMs = oggDuration(f, head)
+	case bytes.HasPrefix(head, []byte("fLaC")):
+		tags, m.durMs = flacMeta(head)
+	case bytes.HasPrefix(head, []byte("ID3")):
+		tags = id3Tags(head)
+	}
+	if v := tags["TITLE"]; v != "" {
+		m.title = v
+	}
+	if v := tags["ARTIST"]; v != "" {
+		m.artist = v
+	}
+	if v := tags["ALBUM"]; v != "" {
+		m.album = v
+	}
+	return m
+}
+
+func vorbisComments(b []byte) map[string]string {
+	t := map[string]string{}
+	if len(b) < 8 {
+		return t
+	}
+	vl := int(binary.LittleEndian.Uint32(b))
+	o := 4 + vl
+	if o+4 > len(b) {
+		return t
+	}
+	cnt := int(binary.LittleEndian.Uint32(b[o:]))
+	o += 4
+	for i := 0; i < cnt && o+4 <= len(b); i++ {
+		l := int(binary.LittleEndian.Uint32(b[o:]))
+		o += 4
+		if l < 0 || o+l > len(b) {
+			break
+		}
+		kv := string(b[o : o+l])
+		o += l
+		if k, v, ok := strings.Cut(kv, "="); ok {
+			k = strings.ToUpper(k)
+			if _, dup := t[k]; !dup {
+				t[k] = v
+			}
+		}
+	}
+	return t
+}
+
+// oggTags sucht OpusTags bzw. Vorbis-Kommentar im (ggf. seitenuebergreifenden) Kopf.
+func oggTags(head []byte) map[string]string {
+	// Ogg-Seiten zu einem Paketstrom zusammensetzen (Kopf reicht fuer Tags)
+	var stream []byte
+	o := 0
+	for o+27 <= len(head) && bytes.Equal(head[o:o+4], []byte("OggS")) {
+		segs := int(head[o+26])
+		if o+27+segs > len(head) {
+			break
+		}
+		l := 0
+		for _, s := range head[o+27 : o+27+segs] {
+			l += int(s)
+		}
+		start := o + 27 + segs
+		if start+l > len(head) {
+			stream = append(stream, head[start:]...)
+			break
+		}
+		stream = append(stream, head[start:start+l]...)
+		o = start + l
+	}
+	if i := bytes.Index(stream, []byte("OpusTags")); i >= 0 {
+		return vorbisComments(stream[i+8:])
+	}
+	if i := bytes.Index(stream, []byte("\x03vorbis")); i >= 0 {
+		return vorbisComments(stream[i+7:])
+	}
+	return nil
+}
+
+func oggDuration(f *os.File, head []byte) uint32 {
+	rate := uint64(48000)
+	preskip := uint64(0)
+	if i := bytes.Index(head, []byte("OpusHead")); i >= 0 && i+12 <= len(head) {
+		preskip = uint64(binary.LittleEndian.Uint16(head[i+10:]))
+	} else if i := bytes.Index(head, []byte("\x01vorbis")); i >= 0 && i+16 <= len(head) {
+		rate = uint64(binary.LittleEndian.Uint32(head[i+12:]))
+	}
+	st, err := f.Stat()
+	if err != nil || rate == 0 {
+		return 0
+	}
+	sz := st.Size()
+	tail := int64(64 * 1024)
+	if tail > sz {
+		tail = sz
+	}
+	buf := make([]byte, tail)
+	if _, err := f.ReadAt(buf, sz-tail); err != nil && err != io.EOF {
+		return 0
+	}
+	i := bytes.LastIndex(buf, []byte("OggS"))
+	if i < 0 || i+14 > len(buf) {
+		return 0
+	}
+	g := binary.LittleEndian.Uint64(buf[i+6:])
+	if g <= preskip {
+		return 0
+	}
+	return uint32((g - preskip) * 1000 / rate)
+}
+
+func flacMeta(head []byte) (map[string]string, uint32) {
+	var tags map[string]string
+	var dur uint32
+	o := 4
+	for o+4 <= len(head) {
+		last := head[o]&0x80 != 0
+		typ := head[o] & 0x7f
+		l := int(head[o+1])<<16 | int(head[o+2])<<8 | int(head[o+3])
+		o += 4
+		if o+l > len(head) {
+			break
+		}
+		blk := head[o : o+l]
+		switch typ {
+		case 0:
+			if len(blk) >= 18 {
+				rate := uint64(blk[10])<<12 | uint64(blk[11])<<4 | uint64(blk[12])>>4
+				total := uint64(blk[13]&0x0f)<<32 | uint64(binary.BigEndian.Uint32(blk[14:]))
+				if rate > 0 {
+					dur = uint32(total * 1000 / rate)
+				}
+			}
+		case 4:
+			tags = vorbisComments(blk)
+		}
+		o += l
+		if last {
+			break
+		}
+	}
+	return tags, dur
+}
+
+func id3Tags(head []byte) map[string]string {
+	t := map[string]string{}
+	if len(head) < 10 {
+		return t
+	}
+	ver := head[3]
+	size := int(head[6]&0x7f)<<21 | int(head[7]&0x7f)<<14 | int(head[8]&0x7f)<<7 | int(head[9]&0x7f)
+	o := 10
+	end := 10 + size
+	if end > len(head) {
+		end = len(head)
+	}
+	names := map[string]string{"TIT2": "TITLE", "TPE1": "ARTIST", "TALB": "ALBUM"}
+	for o+10 <= end {
+		id := string(head[o : o+4])
+		var l int
+		if ver >= 4 {
+			l = int(head[o+4]&0x7f)<<21 | int(head[o+5]&0x7f)<<14 | int(head[o+6]&0x7f)<<7 | int(head[o+7]&0x7f)
+		} else {
+			l = int(binary.BigEndian.Uint32(head[o+4:]))
+		}
+		o += 10
+		if id[0] == 0 || l <= 0 || o+l > end {
+			break
+		}
+		if k, ok := names[id]; ok {
+			t[k] = id3Text(head[o : o+l])
+		}
+		o += l
+	}
+	return t
+}
+
+func id3Text(b []byte) string {
+	if len(b) < 1 {
+		return ""
+	}
+	enc, s := b[0], b[1:]
+	switch enc {
+	case 1, 2: // UTF-16
+		be := enc == 2
+		if len(s) >= 2 && s[0] == 0xff && s[1] == 0xfe {
+			be, s = false, s[2:]
+		} else if len(s) >= 2 && s[0] == 0xfe && s[1] == 0xff {
+			be, s = true, s[2:]
+		}
+		var r []rune
+		for i := 0; i+1 < len(s); i += 2 {
+			var c uint16
+			if be {
+				c = binary.BigEndian.Uint16(s[i:])
+			} else {
+				c = binary.LittleEndian.Uint16(s[i:])
+			}
+			if c == 0 {
+				break
+			}
+			r = append(r, rune(c))
+		}
+		return string(r)
+	case 0: // Latin-1
+		var r []rune
+		for _, c := range s {
+			if c == 0 {
+				break
+			}
+			r = append(r, rune(c))
+		}
+		return string(r)
+	}
+	return strings.TrimRight(string(s), "\x00")
+}
+
+var playerPid string
+
+// playerAudioFile liefert die Audiodatei, die hiby_player gerade offen hat (aus /proc/PID/fd).
+func playerAudioFile() string {
+	if playerPid == "" || !pidAlive(playerPid) {
+		playerPid = findPlayer()
+		if playerPid == "" {
+			return ""
+		}
+	}
+	dir := "/proc/" + playerPid + "/fd"
+	ents, err := os.ReadDir(dir)
+	if err != nil {
+		playerPid = ""
+		return ""
+	}
+	best, bestFd := "", -1
+	for _, e := range ents {
+		l, err := os.Readlink(dir + "/" + e.Name())
+		if err != nil || !isAudio(l) {
+			continue
+		}
+		fd := 0
+		for _, c := range e.Name() {
+			fd = fd*10 + int(c-'0')
+		}
+		if fd > bestFd {
+			best, bestFd = l, fd
+		}
+	}
+	return best
+}
+
+func pidAlive(pid string) bool {
+	l, err := os.Readlink("/proc/" + pid + "/exe")
+	return err == nil && strings.HasSuffix(l, "/hiby_player")
+}
+
+func findPlayer() string {
+	ents, _ := os.ReadDir("/proc")
+	for _, e := range ents {
+		n := e.Name()
+		if n[0] < '0' || n[0] > '9' {
+			continue
+		}
+		if pidAlive(n) {
+			return n
+		}
+	}
+	return ""
+}
+
+func isAudio(p string) bool {
+	switch strings.ToLower(filepath.Ext(p)) {
+	case ".opus", ".flac", ".mp3", ".m4a", ".ogg", ".wav", ".aac", ".ape", ".dsf", ".dff", ".wma", ".aiff":
+		return true
+	}
+	return false
+}
