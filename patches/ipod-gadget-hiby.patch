diff --git a/gadget/ipod_gadget.c b/gadget/ipod_gadget.c
index 369719b..743b29a 100755
--- a/gadget/ipod_gadget.c
+++ b/gadget/ipod_gadget.c
@@ -23,6 +23,10 @@ static bool swap_configs = false;
 module_param(swap_configs, bool, 0);
 MODULE_PARM_DESC(swap_configs, "Present iPod USB config as #1");
 
+static bool high_speed = false;
+module_param(high_speed, bool, 0);
+MODULE_PARM_DESC(high_speed, "Allow USB high speed like a real iPod/iPhone");
+
 static ushort product_id = 0;
 module_param(product_id, ushort, 0);
 MODULE_PARM_DESC(product_id, "Override USB Product ID");
@@ -207,6 +211,36 @@ static struct usb_composite_driver ipod_driver = {
 
 
 
+
+/* Kernel < 4.7: composite_setup reicht Vendor-Requests mit Empfänger "Gerät"
+ * erst NACH SET_CONFIGURATION an Funktionen weiter (kein config0 in req_match).
+ * Radios schicken Apples 0x40 (Ladestrom) aber vorher -> STALL -> Abbruch.
+ * Darum: Setup-Callback des Gadget-Treibers umbiegen und 0x40 selbst quittieren. */
+#include <linux/version.h>
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4,7,0)
+static int (*ipod_orig_setup)(struct usb_gadget *, const struct usb_ctrlrequest *);
+static int ipod_setup_hook(struct usb_gadget *gadget, const struct usb_ctrlrequest *ctrl)
+{
+	if ((ctrl->bRequestType & USB_TYPE_MASK) == USB_TYPE_VENDOR && ctrl->bRequest == 0x40) {
+		struct usb_composite_dev *cdev = get_gadget_data(gadget);
+		struct usb_request *req = cdev->req;
+		int ret;
+		pr_info("apple vendor 0x40 (v%04x i%04x l%d) quittiert\n",
+			le16_to_cpu(ctrl->wValue), le16_to_cpu(ctrl->wIndex), le16_to_cpu(ctrl->wLength));
+		req->length = 0;
+		req->zero = 0;
+		ret = usb_ep_queue(gadget->ep0, req, GFP_ATOMIC);
+		if (ret < 0)
+			pr_err("0x40 ep_queue %d\n", ret);
+		return ret;
+	}
+	if ((ctrl->bRequestType & USB_TYPE_MASK) != USB_TYPE_STANDARD)
+		pr_info("ctrl %02x.%02x v%04x i%04x l%d\n", ctrl->bRequestType, ctrl->bRequest,
+			le16_to_cpu(ctrl->wValue), le16_to_cpu(ctrl->wIndex), le16_to_cpu(ctrl->wLength));
+	return ipod_orig_setup(gadget, ctrl);
+}
+#endif
+
 static int __init ipod_init(void)
 {
 	pr_info("init\n");
@@ -217,12 +251,32 @@ static int __init ipod_init(void)
 		pr_info("swapping usb configuration: ipod is #1\n");
 	}
 
+	if(high_speed) {
+		ipod_driver.max_speed = USB_SPEED_HIGH;
+		pr_info("high speed erlaubt\n");
+	}
+
 	if(product_id != 0) {
 		device_desc.idProduct = cpu_to_le16(product_id);
 		pr_info("override usb idProduct: %04x\n", product_id);
 	}
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4,7,0)
+	{
+		int ret;
+		/* Hook VOR dem Binden setzen: usb_composite_probe kopiert die Vorlage
+		 * nach ipod_driver.gadget_driver und bindet dann an den UDC. */
+		ret = usb_composite_probe(&ipod_driver);
+		if (ret)
+			return ret;
+		ipod_orig_setup = ipod_driver.gadget_driver.setup;
+		ipod_driver.gadget_driver.setup = ipod_setup_hook;
+		pr_info("setup-hook fuer apple 0x40 aktiv\n");
+		return 0;
+	}
+#else
 	return usb_composite_probe(&ipod_driver);
+#endif
 	
 }
 
